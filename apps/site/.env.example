# Copie para apps/site/.env.local (fora do git). Valores locais: `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
# Chave publishable (nunca a secret): a página só chama a RPC pública get_share.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Endereço público do site: base das imagens de prévia (og:image).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Para onde apontam os links "Abrir o app" / "Conhecer o Elaps".
NEXT_PUBLIC_APP_URL=http://localhost:5173
